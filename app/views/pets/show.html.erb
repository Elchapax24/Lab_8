<% if @pet.photo.attached? %>
  <%= image_tag @pet.photo,
      width: 300,
      class: "img-fluid rounded mb-3" %>
<% else %>
  <div class="alert alert-secondary">
    No photo available
  </div>
<% end %>

<h1>Pet Details</h1>

<p><strong>Name:</strong> <%= @pet.name %></p>
<p><strong>Species:</strong> <%= @pet.species %></p>
<p><strong>Breed:</strong> <%= @pet.breed %></p>
<p><strong>Date of Birth:</strong> <%= @pet.date_of_birth %></p>
<p><strong>Weight:</strong> <%= @pet.weight %></p>
<%= link_to "Edit", edit_pet_path(@pet), class: "btn btn-warning" %>

<%= button_to "Delete", pet_path(@pet),
      method: :delete,
      data: { turbo_confirm: "Are you sure?" },
      class: "btn btn-danger" %>

<p>
  <strong>Owner:</strong>
  <%= link_to "#{@pet.owner.first_name} #{@pet.owner.last_name}", owner_path(@pet.owner) %>
</p>

<h2>Appointments</h2>

<ul>
  <% @pet.appointments.each do |appointment| %>
    <li>
      <%= link_to appointment.date, appointment_path(appointment) %>
    </li>
  <% end %>
</ul>

<%= link_to "Back to Pets", pets_path %>
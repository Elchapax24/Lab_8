<h1>Pets</h1>

<%= link_to "New Pet", new_pet_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Species</th>
      <th>Owner</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td><%= link_to pet.name, pet_path(pet) %></td>
        <td><%= pet.species %></td>
        <td><%= pet.owner.first_name %></td>

        <td>
          <%= link_to "Edit", edit_pet_path(pet), class: "btn btn-sm btn-warning" %>

          <%= button_to "Delete", pet_path(pet),
                method: :delete,
                data: { turbo_confirm: "Are you sure?" },
                class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
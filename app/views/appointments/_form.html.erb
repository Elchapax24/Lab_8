
<%= render "shared/error_messages", object: @appointment %>

<%= form_with(model: @appointment) do |form| %>

  <div class="mb-3">
    <%= form.label :pet_id, "Pet" %>
    <%= form.collection_select :pet_id, Pet.all, :id, :name, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :vet_id, "Vet" %>
    <%= form.collection_select :vet_id, Vet.all, :id, :first_name, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :date %>
    <%= form.datetime_field :date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :reason %>
    <%= form.text_area :reason, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :status %>
    <%= form.select :status,
          Appointment.statuses.keys,
          {}, class: "form-select" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>

<% end %>
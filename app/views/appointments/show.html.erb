<h1>Appointment Details</h1>
<%= link_to "New Treatment",
    new_appointment_treatment_path(@appointment),
    class: "btn btn-primary mb-3" %>
<%= link_to "Edit", edit_appointment_path(@appointment), class: "btn btn-warning" %>

<%= button_to "Delete", appointment_path(@appointment),
      method: :delete,
      data: { turbo_confirm: "Are you sure?" },
      class: "btn btn-danger" %>

<%= @appointment.date.strftime("%B %d, %Y") %>
<p><strong>Reason:</strong> <%= @appointment.reason %></p>
<p><strong>Status:</strong> <p><strong>Status:</strong> <%= @appointment.status.titleize %></p>

<p>
  <strong>Pet:</strong>
  <%= link_to @appointment.pet.name, pet_path(@appointment.pet) %>
</p>

<p>
  <strong>Vet:</strong>
  <%= link_to "#{@appointment.vet.first_name} #{@appointment.vet.last_name}", vet_path(@appointment.vet) %>
</p>

<h2>Treatments</h2>

<ul>
  <% @appointment.treatments.each do |treatment| %>
    <li>
      <strong><%= treatment.name %></strong> -
      <%= treatment.medication %> -
      <%= treatment.dosage %> -
      <%= treatment.administered_at.strftime("%B %d, %Y") %><br>
      <%= treatment.notes %><br>

      <%= link_to "Edit",
          edit_appointment_treatment_path(@appointment, treatment),
          class: "btn btn-sm btn-warning" %>

      <%= button_to "Delete",
          appointment_treatment_path(@appointment, treatment),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "btn btn-sm btn-danger" %>
    </li>
  <% end %>
</ul>

<%= link_to "Back to Appointments", appointments_path %>
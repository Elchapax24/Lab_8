<%= link_to "New Appointment", new_appointment_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Date</th>
      <th>Pet</th>
      <th>Vet</th>
      <th>Reason</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @appointments.each do |appointment| %>
      <tr>
        <td>
          <%= link_to appointment.date.strftime("%B %d, %Y"), appointment_path(appointment) %>
        </td>
        <td><%= appointment.pet.name %></td>
        <td>
          <%= "#{appointment.vet.first_name} #{appointment.vet.last_name}" %>
        </td>
        <td><%= appointment.reason %></td>
        <td><%= appointment.status.titleize %></td>
         <td>
        <%= link_to "Edit", edit_appointment_path(appointment), class: "btn btn-sm btn-warning" %>

        <%= button_to "Delete", appointment_path(appointment),
              method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<h1>Owner Details</h1>
<%= link_to "Edit", edit_owner_path(@owner), class: "btn btn-warning" %>


<p><strong>Name:</strong> <%= @owner.first_name %> <%= @owner.last_name %></p>
<p><strong>Email:</strong> <%= @owner.email %></p>
<p><strong>Phone:</strong> <%= @owner.phone %></p>
<p><strong>Address:</strong> <%= @owner.address %></p>

<h2>Pets</h2>

<ul>
  <% @owner.pets.each do |pet| %>
    <li>
      <%= link_to pet.name, pet_path(pet) %>
    </li>
  <% end %>
</ul>

<%= link_to "Back to Owners", owners_path %>

<%= button_to "Delete", owner_path(@owner),
      method: :delete,
      data: { turbo_confirm: "Are you sure?" },
      class: "btn btn-danger" %>